digraph ovn_bgp {
  graph [rankdir=TB, bgcolor="#ffffff", pad=0.2, nodesep=0.38, ranksep=0.50,
         fontname="Helvetica", newrank=true];
  node [shape=box, style="rounded,filled", fillcolor="#eff6ff", color="#64748b",
        fontname="Helvetica", fontcolor="#172b4d", margin="0.14,0.10"];
  edge [color="#475569", penwidth=1.4, fontname="Helvetica",
        fontcolor="#334155", fontsize=10, arrowsize=0.7];

  subgraph cluster_fabric {
    label="Fabric VM"; labeljust=l; color="#94a3b8"; style=rounded; margin=16;
    spine [shape=plain, label=<
      <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#64748b" BGCOLOR="#eff6ff">
        <TR><TD COLSPAN="2"><B>spine</B><BR/>FRR · AS65233 · lo 203.0.113.10/32</TD></TR>
        <TR><TD PORT="eth1" BGCOLOR="#dbeafe">eth1</TD><TD PORT="eth2" BGCOLOR="#dbeafe">eth2</TD></TR>
      </TABLE>>];
    leaf1 [shape=plain, label=<
      <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#64748b" BGCOLOR="#eff6ff">
        <TR><TD PORT="eth2" COLSPAN="2" BGCOLOR="#dbeafe">eth2</TD></TR>
        <TR><TD COLSPAN="2"><B>leaf1 · ToR</B><BR/>FRR · AS65232</TD></TR>
        <TR><TD PORT="eth1" BGCOLOR="#dbeafe">eth1</TD><TD PORT="eth3" BGCOLOR="#dbeafe">eth3</TD></TR>
      </TABLE>>];
    leaf2 [shape=plain, label=<
      <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#64748b" BGCOLOR="#eff6ff">
        <TR><TD PORT="eth2" COLSPAN="2" BGCOLOR="#dbeafe">eth2</TD></TR>
        <TR><TD COLSPAN="2"><B>leaf2 · ToR</B><BR/>FRR · AS65234</TD></TR>
        <TR><TD PORT="eth1" BGCOLOR="#dbeafe">eth1</TD><TD PORT="eth3" BGCOLOR="#dbeafe">eth3</TD></TR>
      </TABLE>>];
    {rank=same; leaf1; leaf2}
  }

  subgraph cluster_controller {
    label="OpenStack controller + compute VM"; labeljust=l; labelloc=b;
    style=rounded; color="#94a3b8"; margin=16;
    controller_ports [shape=plain, label=<
      <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#64748b" BGCOLOR="#eff6ff">
        <TR><TD PORT="tor1" BGCOLOR="#dbeafe">ovn-tor1<BR/><FONT POINT-SIZE="9">virtio NIC</FONT></TD><TD PORT="tor2" BGCOLOR="#dbeafe">ovn-tor2<BR/><FONT POINT-SIZE="9">virtio NIC</FONT></TD></TR>
        <TR><TD>br-bgp-0</TD><TD>br-bgp-1</TD></TR>
        <TR><TD COLSPAN="2"><B>FRR · AS65231</B><BR/>lo 203.0.113.31/32</TD></TR>
      </TABLE>>];
    controller_ovn [label="OVN · br-int / br-ex\nTenant flat provider network"];
    subgraph cluster_controller_guest {
      label="Tenant VM"; labelloc=b; color="#94a3b8"; style=rounded;
      vm1 [label="Fixed IP 10.53.0.22/32", fillcolor="#f0fdf4"];
    }
    controller_ports -> controller_ovn [dir=none];
    controller_ovn -> vm1 [dir=none, label="  compute TAP"];
  }

  subgraph cluster_compute {
    label="OpenStack compute VM"; labeljust=l; labelloc=b;
    style=rounded; color="#94a3b8"; margin=16;
    compute_ports [shape=plain, label=<
      <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#64748b" BGCOLOR="#eff6ff">
        <TR><TD PORT="tor1" BGCOLOR="#dbeafe">ovn-tor1<BR/><FONT POINT-SIZE="9">virtio NIC</FONT></TD><TD PORT="tor2" BGCOLOR="#dbeafe">ovn-tor2<BR/><FONT POINT-SIZE="9">virtio NIC</FONT></TD></TR>
        <TR><TD>br-bgp-0</TD><TD>br-bgp-1</TD></TR>
        <TR><TD COLSPAN="2"><B>FRR · AS65235</B><BR/>lo 203.0.113.32/32</TD></TR>
      </TABLE>>];
    compute_ovn [label="OVN · br-int / br-ex\nTenant flat provider network"];
    subgraph cluster_compute_guest {
      label="Tenant VM"; labelloc=b; color="#94a3b8"; style=rounded;
      vm2 [label="Fixed IP 10.53.0.23/32", fillcolor="#f0fdf4"];
    }
    compute_ports -> compute_ovn [dir=none];
    compute_ovn -> vm2 [dir=none, label="  compute TAP"];
  }

  spine:eth1:s -> leaf1:eth2:n [dir=none];
  spine:eth2:s -> leaf2:eth2:n [dir=none];
  leaf1:eth1:s -> controller_ports:tor1:n [dir=none, label="L2"];
  leaf2:eth1:s -> controller_ports:tor2:n [dir=none, label="L2"];
  leaf1:eth3:s -> compute_ports:tor1:n [dir=none, label="L2"];
  leaf2:eth3:s -> compute_ports:tor2:n [dir=none, label="L2"];
}
