# nodes.yml から生成。直接編集しない。
name: {{ lab_name }}
mgmt:
  network: clab-{{ lab_name }}-mgmt
  ipv4-subnet: {{ mgmt_subnet }}
topology:
  defaults:
    kind: linux
    image: quay.io/frrouting/frr:10.4.1
  groups:
    router:
      network-mode: none
      sysctls: &router_sysctls
        net.ipv4.ip_forward: 1
        net.ipv4.fib_multipath_hash_policy: 1
        net.ipv4.conf.all.rp_filter: 0
        net.ipv4.conf.default.rp_filter: 0
        net.ipv6.conf.all.disable_ipv6: 0
        net.ipv6.conf.default.disable_ipv6: 0
        net.ipv6.conf.default.accept_ra_defrtr: 0
      binds:
        - ../../common/frr/daemons:/etc/frr/daemons:ro
    spine:
      network-mode: none
      sysctls: *router_sysctls
      binds:
        - ../frr/spine-daemons:/etc/frr/daemons:ro
    k8s-frr:
      binds:
        - ../../common/frr/daemons:/etc/frr/daemons:ro
      exec:
        - sysctl -w net.ipv4.ip_forward=1 net.ipv4.fib_multipath_hash_policy=1 net.ipv4.conf.all.rp_filter=0 net.ipv4.conf.default.rp_filter=0 net.ipv4.conf.k8s-leaf1.rp_filter=0 net.ipv4.conf.k8s-leaf2.rp_filter=0 net.ipv6.conf.all.disable_ipv6=0 net.ipv6.conf.default.disable_ipv6=0 net.ipv6.conf.default.accept_ra_defrtr=0
        - ip route replace 127.0.0.0/8 dev lo scope link
        - sh -c 'ip route del default dev eth0 || true'
  nodes:
    nat:
      sysctls: *router_sysctls
      binds:
        - ../../common/frr/daemons:/etc/frr/daemons:ro
        - nat.conf:/etc/frr/frr.conf:ro
{% for node in fabric_nodes if node.role in ['spine', 'leaf', 'client'] %}
    {{ node.name }}:
      group: {{ 'spine' if node.role == 'spine' else 'router' }}
      binds:
        - {{ node.name }}.conf:/etc/frr/frr.conf:ro
{% endfor %}
{% for node in k8s_nodes %}
    {{ node.name }}:
      group: k8s-frr
      network-mode: container:{{ node.kind_node }}
      binds:
        - {{ node.name }}.conf:/etc/frr/frr.conf:ro
{% endfor %}
  links:
    - endpoints: ["nat:eth1", "spine1:eth3"]
    - endpoints: ["nat:eth2", "spine2:eth3"]
    - endpoints: ["leaf1:eth1", "spine1:eth1"]
    - endpoints: ["leaf1:eth2", "spine2:eth1"]
    - endpoints: ["leaf2:eth1", "spine1:eth2"]
    - endpoints: ["leaf2:eth2", "spine2:eth2"]
{% for host in hosts_on_leaf %}
{% set prefix = 'eth' if host.role == 'client' else 'k8s-leaf' %}
    - endpoints: ["leaf1:eth{{ loop.index + 2 }}", "{{ host.name }}:{{ prefix }}1"]
    - endpoints: ["leaf2:eth{{ loop.index + 2 }}", "{{ host.name }}:{{ prefix }}2"]
{% endfor %}
