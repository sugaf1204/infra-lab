network:
  version: 2
  renderer: networkd
  ethernets:
    lo:
      addresses: ["{{ node.address }}/32"]
      # Zebra resolves the Cilium peer through the main routing table.
      routes:
        - to: 127.0.0.0/8
          scope: link
    k8s-tor1:
      link-local: [ipv6]
      accept-ra: false
    k8s-tor2:
      link-local: [ipv6]
      accept-ra: false
