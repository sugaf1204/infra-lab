apiVersion: kubeadm.k8s.io/v1beta4
kind: InitConfiguration
localAPIEndpoint:
  advertiseAddress: 10.220.255.10
skipPhases:
  - addon/kube-proxy
nodeRegistration:
  taints: []
  name: cilium-l3-node
  criSocket: unix:///run/containerd-cilium-lab/containerd.sock
  kubeletExtraArgs:
    - name: node-ip
      value: 10.220.255.10
---
apiVersion: kubeadm.k8s.io/v1beta4
kind: ClusterConfiguration
kubernetesVersion: ${KUBERNETES_VERSION}
networking:
  podSubnet: 10.220.0.0/20
  serviceSubnet: 10.221.0.0/16
