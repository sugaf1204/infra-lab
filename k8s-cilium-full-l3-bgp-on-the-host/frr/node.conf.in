frr defaults traditional
hostname cilium-host-frr
!
ip prefix-list NODE-LOOPBACK permit @NODE_IP@/32
ip prefix-list PODS permit 10.220.0.0/20 ge 32
ip prefix-list VIPS permit 10.220.250.0/24 ge 32
ip prefix-list FABRIC permit 0.0.0.0/0
ip prefix-list FABRIC permit 10.220.0.0/20 ge 32
ip prefix-list FABRIC permit 10.220.255.10/31 ge 32
ip prefix-list EXPORT permit 10.220.0.0/20 ge 32
ip prefix-list EXPORT permit 10.220.250.0/24 ge 32
ip prefix-list EXPORT permit @NODE_IP@/32
ip prefix-list DENY-ALL deny 0.0.0.0/0 le 32
!
route-map NODE-LOOPBACK permit 10
 match ip address prefix-list NODE-LOOPBACK
 set ip next-hop @NODE_IP@
!
route-map PODS permit 10
 match ip address prefix-list PODS
!
route-map CILIUM-VIPS permit 10
 match ip address prefix-list VIPS
 set ip next-hop @NODE_IP@
!
route-map INSTALL-FABRIC permit 10
 match ip address prefix-list FABRIC
 set src @NODE_IP@
!
ip protocol bgp route-map INSTALL-FABRIC
!
router bgp @ASN@
 bgp router-id @NODE_IP@
 no bgp default ipv4-unicast
 ! The VIP update has the local Cilium address as its next hop.
 bgp allow-martian-nexthop
 neighbor CILIUM peer-group
 neighbor CILIUM remote-as 65201
 neighbor CILIUM update-source lo
 neighbor CILIUM ebgp-multihop 2
 bgp listen range 127.0.0.2/32 peer-group CILIUM
 !
 bgp bestpath as-path multipath-relax
 neighbor k8s-tor1 interface remote-as 65101
 neighbor k8s-tor1 timers 3 9
 neighbor k8s-tor2 interface remote-as 65102
 neighbor k8s-tor2 timers 3 9
 address-family ipv4 unicast
  redistribute connected route-map NODE-LOOPBACK
  redistribute kernel route-map PODS
  neighbor CILIUM activate
  neighbor CILIUM route-map CILIUM-VIPS in
  neighbor CILIUM prefix-list DENY-ALL out
  neighbor k8s-tor1 activate
  neighbor k8s-tor1 prefix-list FABRIC in
  neighbor k8s-tor1 prefix-list EXPORT out
  neighbor k8s-tor2 activate
  neighbor k8s-tor2 prefix-list FABRIC in
  neighbor k8s-tor2 prefix-list EXPORT out
  maximum-paths 2
 exit-address-family
