! データセンター向けプロファイル（BGP 設定やタイマーの最適化）
frr defaults datacenter
hostname {{ node.name }}
!
interface lo
 ip address {{ node.address }}/32
exit
!
! --- プレフィックスリスト（経路フィルタ） ---
! ToR から受信する /32 ホストルート（Node IP, Pod IP, Service VIP）のみを許可
ip prefix-list HOST-ROUTES permit 0.0.0.0/0 ge 32
! 自クライアントの IP のみを許可
ip prefix-list SELF permit {{ node.address }}/32
!
! --- ルートマップ ---
! eBGP Unnumbered では next-hop が IPv6 リンクローカルになるため、
! カーネル FIB へのインストール時に IPv4 送信元 IP（src）として自クライアント IP を設定
route-map INSTALL-FABRIC permit 10
 match ip address prefix-list HOST-ROUTES
 set src {{ node.address }}
!
! BGP 学習経路のカーネル反映時に上記ルートマップを適用
ip protocol bgp route-map INSTALL-FABRIC
!
! --- BGP 設定 ---
router bgp {{ node.asn }}
 bgp router-id {{ node.address }}
 ! IPv4 ユニキャストの自動有効化を無効化
 no bgp default ipv4-unicast
 ! 異なる AS からの経路でもパス長が同じであれば ECMP を許可
 bgp bestpath as-path multipath-relax
 !
 ! ToR スイッチ向けピアグループ
 neighbor TORS peer-group
 neighbor TORS remote-as external
 neighbor TORS timers 3 9
 !
 ! ToR への接続（eth1: tor1, eth2: tor2）- eBGP Unnumbered
 neighbor eth1 interface peer-group TORS
 neighbor eth2 interface peer-group TORS
 !
 address-family ipv4 unicast
  ! 自ノードの IP を BGP に投入
  network {{ node.address }}/32
  neighbor TORS activate
  ! ToR からは /32 ホストルートを受信
  neighbor TORS prefix-list HOST-ROUTES in
  ! ToR へは自クライアント IP のみを広報
  neighbor TORS prefix-list SELF out
  ! ToR 2 台への ECMP（最大 2 パス）
  maximum-paths 2
 exit-address-family
!
