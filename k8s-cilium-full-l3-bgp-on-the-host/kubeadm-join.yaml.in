apiVersion: kubeadm.k8s.io/v1beta4
kind: JoinConfiguration
discovery:
  bootstrapToken:
    apiServerEndpoint: 10.220.255.10:6443
    token: ${JOIN_TOKEN}
    caCertHashes:
      - sha256:${CA_HASH}
nodeRegistration:
  name: cilium-l3-worker
  criSocket: unix:///run/containerd-cilium-lab/containerd.sock
  kubeletExtraArgs:
    - name: node-ip
      value: 10.220.255.11
