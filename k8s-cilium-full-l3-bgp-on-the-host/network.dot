digraph cilium {
  graph [rankdir=TB, bgcolor="#ffffff", pad=0.2, nodesep=0.48, ranksep=0.58,
         fontname="Helvetica", newrank=true];
  node [shape=box, style="rounded,filled", fillcolor="#eff6ff", color="#64748b",
        fontname="Helvetica", fontcolor="#172b4d", margin="0.14,0.1"];
  edge [color="#475569", penwidth=1.4, fontname="Helvetica",
        fontcolor="#334155", fontsize=10, arrowsize=0.7];

  client [shape=plain, label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#64748b" BGCOLOR="#f0fdf4">
      <TR><TD><B>External client</B><BR/>FRR · AS65203<BR/>lo 10.220.240.14/32</TD></TR>
      <TR><TD PORT="eth1" BGCOLOR="#dcfce7">eth1</TD></TR>
    </TABLE>>];
  tor [shape=plain, label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#64748b" BGCOLOR="#eff6ff">
      <TR><TD PORT="eth2" BGCOLOR="#dbeafe">eth2</TD></TR>
      <TR><TD><B>tor1</B><BR/>FRR · AS65101</TD></TR>
      <TR><TD PORT="eth1" BGCOLOR="#dbeafe">eth1</TD></TR>
    </TABLE>>];

  subgraph cluster_node {
    label="Kubernetes node  |  VM · single-node kubeadm"; labeljust=l; labelloc=b;
    style=rounded; color="#94a3b8"; margin=16;
    router [shape=plain, label=<
      <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#64748b" BGCOLOR="#eff6ff">
        <TR><TD PORT="eth2" COLSPAN="2" BGCOLOR="#dbeafe">eth2</TD></TR>
        <TR><TD COLSPAN="2"><B>node-frr · AS65202</B><BR/>FRR container network namespace</TD></TR>
        <TR><TD PORT="eth1" BGCOLOR="#dbeafe">eth1</TD><TD PORT="eth3" BGCOLOR="#dbeafe">eth3</TD></TR>
      </TABLE>>];

    subgraph cluster_hostns {
      label="Host network namespace"; labeljust=l; labelloc=b; style=rounded; color="#94a3b8"; margin=16;
      uplink [label="cilium-uplink", fillcolor="#dbeafe"];
      bgp [label="Cilium BGP · AS65201\nExports Pod CIDR + VIP"];
      datapath [label="Linux datapath + kube-proxy\nLoadBalancer VIP 10.220.250.10"];
      egress [shape=plain, label=<
        <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#64748b" BGCOLOR="#eff6ff">
          <TR><TD PORT="routes" BGCOLOR="#dbeafe">cilium-routes</TD></TR>
          <TR><TD><B>VRF cilium-egress</B> · table 220<BR/>kube-host-frr · AS65204<BR/>IPv4 default via IPv6</TD></TR>
        </TABLE>>];

      uplink -> bgp [dir=none, color="#2563a5", style=dashed, label="BGP socket"];
      uplink -> datapath [label="Ingress"];
      datapath -> egress [color="#15803d", fontcolor="#166534", label="  Pod-source policy\n  routing", constraint=false];
      {rank=same; uplink; egress}
      {rank=same; bgp; datapath}
    }
    subgraph cluster_pod {
      label="Probe Pod"; labelloc=b; style=rounded; color="#94a3b8";
      pod [label="eth0\nPod IP", fillcolor="#f0fdf4"];
    }
    router:eth1:s -> uplink [dir=none, color="#475569"];
    router:eth3:s -> egress:routes:n [dir=none, color="#475569"];
    datapath -> pod [dir=none, label="  lxc… ↔ eth0 · veth"];
  }
  client:eth1:s -> tor:eth2:n [dir=none, color="#475569"];
  tor:eth1:s -> router:eth2:n [dir=none, color="#475569"];
}
